{
  "manifest_version": 3,
  "name": "Lemonade",
  "version": "0.3.0",
  "description": "Add friction back to learning by auto-blocking major AI tools.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "incognito": "spanning",
  "icons": {
    "16": "icons/icon-16x16.png",
    "48": "icons/icon-32x32.png",
    "128": "icons/icon-512x512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16x16.png",
      "48": "icons/icon-32x32.png",
      "128": "icons/icon-512x512.png"
    }
  },
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://*.perplexity.ai/*",
    "*://*.copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}