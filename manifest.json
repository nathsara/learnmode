{
  "manifest_version": 3,
  "name": "LearnMode",
  "version": "0.2.0",
  "description": "Friction and intent logging for AI tool usage.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "tabs"
  ],
  "incognito": "spanning",
  "host_permissions": [
    "*://*.chatgpt.com/*",
    "*://*.openai.com/*",
    "*://*.claude.ai/*",
    "*://*.gemini.google.com/*",
    "*://*.perplexity.ai/*",
    "*://*.copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}